# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=your_role_name
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=CASCADE_DEMO
SNOWFLAKE_CONNECTION=your_connection_name

# Agent Configuration
AGENT_NAME=CASCADE_FINANCIAL_ANALYST
SEMANTIC_VIEW=${SNOWFLAKE_DATABASE}.CASCADE_DEMO.FINANCIAL_ANALYTICS
